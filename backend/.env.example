# ================================
# Django Core
# ================================
DEBUG=True
DJANGO_SECRET_KEY=replace-with-a-secure-secret-key

# Optional hard cut date for ML training data (ISO datetime)
# ML_TRAINING_CUTOFF_DATE=2026-01-01T00:00:00+00:00

# ================================
# Database
# ================================
# Production/Postgres example:
# DATABASE_URL=postgresql://user:password@localhost:5432/ai_scalp
# Local fallback is SQLite when DATABASE_URL is unset.
DATABASE_URL=

# ================================
# Broker Selection
# ================================
# capital (default) or alpaca (legacy fallback)
BROKER_PROVIDER=capital

# marketd/Go cutover flag
USE_GO_MARKETD=False

# ================================
# Capital.com Trading Mode
# ================================
# demo or live
CAPITAL_TRADING_MODE=demo

# Optional epic suffix for US stocks, e.g. AAPL -> AAPL.US
CAPITAL_EPIC_SUFFIX=.US

# Generic Capital credentials (fallback for both modes)
CAPITAL_API_KEY=
CAPITAL_IDENTIFIER=
CAPITAL_PASSWORD=
CAPITAL_BASE_URL=

# -------------------------------
# Capital Demo Credentials (preferred for demo mode)
# -------------------------------
CAPITAL_DEMO_API_KEY=
CAPITAL_DEMO_IDENTIFIER=
CAPITAL_DEMO_PASSWORD=
CAPITAL_DEMO_BASE_URL=https://demo-api-capital.backend-capital.com

# -------------------------------
# Capital Live Credentials (preferred for live mode)
# -------------------------------
CAPITAL_LIVE_API_KEY=
CAPITAL_LIVE_IDENTIFIER=
CAPITAL_LIVE_PASSWORD=
CAPITAL_LIVE_BASE_URL=https://api-capital.backend-capital.com

# ================================
# Alpaca (legacy/fallback only)
# ================================
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_DATA_URL=https://data.alpaca.markets
ALPACA_TRADING_URL=https://api.alpaca.markets
