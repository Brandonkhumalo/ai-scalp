# Shared with Django
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ai_scalp?sslmode=disable
ALPACA_API_KEY=your_alpaca_key
ALPACA_API_SECRET=your_alpaca_secret
USE_GO_MARKETD=false

# marketd specific
MARKETD_SHADOW_MODE=true
MARKETD_LOG_LEVEL=info
MARKETD_SCALPING_INTERVAL=15s
MARKETD_RECONCILIATION_INTERVAL=2m
MARKETD_SCALPING_PROFIT_TARGET=0.02
MARKETD_SCALPING_STOP_LOSS=0.01
MARKETD_MARKET_DATA_FEED=iex
MARKETD_LISTEN_ADDR=:8090
ALPACA_RPS=8
ALPACA_BURST=8
